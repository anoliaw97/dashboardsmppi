<!DOCTYPE html>
<html lang="@ViewBag.Lang">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SMPPI Dashboard — @ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>
<body class="bg-slate-50 min-h-screen font-inter">

    <!-- Top Navigation Bar -->
    <header class="bg-gradient-to-r from-blue-700 to-blue-900 text-white shadow-lg">
        <div class="max-w-screen-2xl mx-auto px-6 py-4 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 bg-white/20 rounded-xl flex items-center justify-center">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                         stroke-linejoin="round">
                        <ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5V19A9 3 0 0 0 21 19V5"/>
                        <path d="M3 12A9 3 0 0 0 21 12"/>
                    </svg>
                </div>
                <div>
                    <h1 class="text-lg font-bold leading-tight">SMPPI</h1>
                    <p class="text-xs text-blue-200">
                        @(ViewBag.Lang == "ms"
                            ? "Sistem Maklumat Pengurusan Penyelidikan &amp; Inovasi"
                            : "Research &amp; Innovation Management Information System")
                    </p>
                </div>
            </div>

            <div class="flex items-center gap-4">
                <!-- Language toggle -->
                <div class="flex items-center gap-1 bg-white/10 rounded-lg p-1">
                    <a href="?lang=en"
                       class="px-3 py-1 rounded-md text-sm font-medium transition-all @(ViewBag.Lang == "en" ? "bg-white text-blue-800" : "text-blue-100 hover:bg-white/20")">
                        EN
                    </a>
                    <a href="?lang=ms"
                       class="px-3 py-1 rounded-md text-sm font-medium transition-all @(ViewBag.Lang == "ms" ? "bg-white text-blue-800" : "text-blue-100 hover:bg-white/20")">
                        BM
                    </a>
                </div>

                <span class="text-blue-200 text-sm hidden sm:block">
                    @DateTime.Now.ToString("dd MMM yyyy")
                </span>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main class="max-w-screen-2xl mx-auto px-4 sm:px-6 py-6">
        @RenderBody()
    </main>

    <!-- Scripts -->
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
